# Copy to .env.local for local development. In production, set these in the
# hosting platform's dashboard (Render → Environment) — never commit real values.

# Admin area
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Claim Lookup (search a client/address → Contractors Cloud claim → Notion resources)
# Shared passphrase the team enters once every 12 hours to unlock lookups.
TEAM_PASSWORD=change-me-too

# Contractors Cloud: Integrations → API Access Tokens. Create the token from a
# user whose access matches what the team should see.
CC_API_TOKEN=
# Optional — only change if api.contractorscloud.com/docs shows a different base.
# CC_API_BASE_URL=https://api.contractorscloud.com/api/v1
# Optional — adds an "Open in Contractors Cloud" link. {id}, {hash}, {number} are filled in.
# CC_PROJECT_URL_TEMPLATE=https://yourcompany.contractorscloud.com/projects/{id}

# Notion: create an internal integration at notion.so/profile/integrations,
# then share "Welcome to the Approvals Team Workspace" with it (••• → Connections).
NOTION_API_KEY=
# Optional — the Building Codes → Illinois Cities database.
# NOTION_CITIES_DATABASE_ID=af22398c211045178f8daf441c9be7df
